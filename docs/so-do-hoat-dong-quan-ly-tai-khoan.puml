@startuml Sơ đồ hoạt động - Quản lý tài khoản cá nhân
!theme plain
skinparam backgroundColor #FEFEFE
skinparam ActivityFontSize 12

|Khách hàng|
start
:Yêu cầu quản lý tài khoản;
note right: Cần đăng nhập trước

|Hệ thống|
:Lấy thông tin người dùng;
:Hiển thị trang thông tin cá nhân;

|Khách hàng|
:Chọn thao tác;

if (Thao tác?) then (Cập nhật thông tin)
  |Khách hàng|
  :Chỉnh sửa họ tên, SĐT, địa chỉ;
  :Gửi cập nhật;
  |Hệ thống|
  :Xác thực dữ liệu;
  if (Hợp lệ?) then (Đúng)
    :Lưu thông tin vào Database;
    :Thông báo cập nhật thành công;
  else (Sai)
    #FFCDD2:Thông báo lỗi;
    :Hiển thị form sửa;
  endif
else (Đổi mật khẩu)
  |Khách hàng|
  :Nhập mật khẩu hiện tại;
  :Nhập mật khẩu mới;
  :Gửi đổi mật khẩu;
  |Hệ thống|
  :Xác thực mật khẩu hiện tại;
  if (Đúng?) then (Đúng)
    :Cập nhật mật khẩu mới;
    :Thông báo đổi mật khẩu thành công;
  else (Sai)
    #FFCDD2:Thông báo mật khẩu hiện tại không đúng;
    :Hiển thị form đổi mật khẩu;
  endif
else (Chỉ xem)
  |Khách hàng|
  :Xem thông tin cá nhân;
endif

stop

@enduml
