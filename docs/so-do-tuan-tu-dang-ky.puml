@startuml UC01_Dang_ky_tuan_tu
' Đồng bộ với so-do-tuan-tu-uc01-dang-ky.puml

skinparam backgroundColor #FEFEFE
skinparam ParticipantPadding 14
skinparam SequenceMessageAlign center

actor "Khách vãng lai" as K
boundary "Form đăng ký" as F
control "Điều khiển đăng ký" as C
database "CSDL" as DB

== Bước 1-2: Truy cập, nhập liệu, gửi yêu cầu ==
K -> F: 1. Truy cập trang đăng ký
activate F
F --> K: Hiển thị form\n(email, mật khẩu, xác nhận MK,\nhọ tên, số điện thoại)
deactivate F

K -> F: 2. Gửi thông tin đăng ký
activate F
F -> C: Yêu cầu đăng ký (dữ liệu)
activate C
deactivate F

== Bước 3: Kiểm tra hợp lệ và email ==
C -> C: Kiểm tra định dạng,\nkhớp mật khẩu xác nhận

alt [3b] Mật khẩu không khớp
  activate F
  C --> F: Thông báo lỗi
  F --> K: "Xác nhận mật khẩu không đúng"
  deactivate F
  deactivate C
else [MK hợp lệ] Kiểm tra email trong CSDL
  C -> DB: SELECT đếm theo email
  activate DB
  DB --> C: Số bản ghi (0 hoặc >0)
  deactivate DB

  alt [3a] Email đã tồn tại
    activate F
    C --> F: Thông báo lỗi
    F --> K: "Email đã được sử dụng"
    deactivate F
    deactivate C
  else [Email chưa trùng] Lưu tài khoản
    C -> DB: 4. INSERT (vai trò CUSTOMER)
    activate DB
    DB --> C: OK
    deactivate DB
    activate F
    C --> F: 5. Thành công + chuyển hướng đăng nhập
    F --> K: Thông báo đăng ký thành công\n→ trang đăng nhập
    deactivate F
    deactivate C
    note right of K
      Điều kiện sau: tài khoản CUSTOMER.
      6. Kết thúc use case.
    end note
  end
end

@enduml
