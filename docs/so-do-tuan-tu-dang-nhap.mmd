%% Biểu đồ tuần tự - Đăng nhập (UC02)
%% Mermaid: https://mermaid.live

sequenceDiagram
    actor ND as Người dùng
    participant FC as Form Trang chủ
    participant FD as Form Đăng nhập
    participant CTL as Control Đăng nhập
    participant DB as CSDL

    ND->>FC: Truy cập trang chủ / ứng dụng
    FC-->>ND: Hiển thị giao diện trang chủ
    ND->>FC: Chọn Đăng nhập
    FC->>FD: Điều hướng mở form đăng nhập
    FD-->>ND: Hiển thị form email, mật khẩu

    ND->>FD: Nhập email, mật khẩu và gửi
    FD->>CTL: Gửi yêu cầu đăng nhập (email, mật khẩu)
    CTL->>DB: Truy vấn người dùng theo email
    DB-->>CTL: Bản ghi / không có

    alt Thông tin đúng
        CTL->>CTL: Kiểm tra bi_khoa
        alt Chưa bị khóa
            CTL->>CTL: Tạo phiên (JWT / session)
            CTL-->>FD: Thành công + token + vai trò
            FD-->>ND: Chuyển hướng trang chủ theo vai trò
        else Bị khóa
            CTL-->>FD: Lỗi (tài khoản khóa)
            FD-->>ND: Thông báo tài khoản đã bị khóa
        end
    else Sai email hoặc mật khẩu
        CTL-->>FD: Lỗi xác thực
        FD-->>ND: Email hoặc mật khẩu không đúng
    end
