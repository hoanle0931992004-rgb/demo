      <td>PK</td>
      <td></td>
    </tr>
    <tr><td>id_nguoi_dung</td><td>varchar(64)</td><td>No</td><td>FK ON DELETE CASCADE</td><td>nguoi_dungs.id</td></tr>
    <tr><td>token</td><td>varchar(255)</td><td>No</td><td>UNIQUE</td><td></td></tr>
    <tr><td>het_han</td><td>timestamptz</td><td>No</td><td></td><td></td></tr>
    <tr><td>ngay_tao</td><td>timestamptz</td><td>No</td><td>DEFAULT now()</td><td></td></tr>
  </tbody>
</table>

