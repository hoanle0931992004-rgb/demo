@startuml UC03_Quan_ly_tai_khoan_tuan_tu
' Đồng bộ với so-do-tuan-tu-uc03-quan-ly-tai-khoan.puml

skinparam backgroundColor #FEFEFE
skinparam ParticipantPadding 14
skinparam SequenceMessageAlign center

actor "Khách hàng" as KH
boundary "Form quản lý\ntài khoản" as F
control "Điều khiển hồ sơ" as C
database "CSDL" as DB

== Bước 1-2: Truy cập và xem thông tin ==
KH -> F: 1. Truy cập trang quản lý tài khoản\n(đã đăng nhập)
activate F
F -> C: Yêu cầu dữ liệu hồ sơ (session)
activate C
C -> DB: SELECT thông tin người dùng\n(nguoi_dungs)
activate DB
DB --> C: họ tên, email, SĐT, địa chỉ, avatar, ...
deactivate DB
C --> F: Dữ liệu hiển thị
F --> KH: 2. Hiển thị thông tin cá nhân hiện tại
deactivate C
deactivate F

== Bước 3-4: Cập nhật hồ sơ hoặc đổi mật khẩu ==
KH -> F: Thao tác trên form
activate F

alt [3a] Chỉnh sửa thông tin và gửi
  F -> C: Dữ liệu cập nhật (không đổi MK)
  activate C
  deactivate F
  C -> DB: 4a. UPDATE nguoi_dungs\n(họ tên, SĐT, địa chỉ, avatar, ...)
  activate DB
  DB --> C: OK
  deactivate DB
  activate F
  C --> F: Lưu thành công
  F --> KH: Thông báo thành công
  deactivate F
  deactivate C

else [3b] Đổi mật khẩu (mật khẩu cũ + mới)
  F -> C: Mật khẩu cũ, mật khẩu mới, xác nhận
  activate C
  deactivate F
  C -> DB: Đọc hash mật khẩu hiện tại\n(so khớp mật khẩu cũ)
  activate DB
  DB --> C: Dữ liệu xác thực
  deactivate DB

  alt [thay thế] Mật khẩu cũ sai
    activate F
    C --> F: Thông báo lỗi
    F --> KH: Yêu cầu nhập lại
    deactivate F
    deactivate C
  else Mật khẩu cũ đúng
    C -> DB: 4b. UPDATE mat_khẩu (mật khẩu mới)
    activate DB
    DB --> C: OK
    deactivate DB
    activate F
    C --> F: Cập nhật mật khẩu thành công
    F --> KH: Thông báo (tuỳ chọn)
    deactivate F
    deactivate C
  end
end

note over KH
  5. Kết thúc use case.
  Điều kiện sau: thông tin hoặc mật khẩu đã cập nhật.
end note

@enduml
