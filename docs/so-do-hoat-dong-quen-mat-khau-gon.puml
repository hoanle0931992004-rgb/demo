@startuml Quên mật khẩu
title Quên mật khẩu
!theme plain
skinparam backgroundColor #FEFEFE
skinparam ActivityFontSize 13

|Người dùng|
start
:Truy cập trang quên mật khẩu;
label nhap_email
:Nhập email đăng ký và gửi yêu cầu khôi phục mật khẩu;

|Hệ thống|
if (Email có trong hệ thống?) then (Có)
  :Tạo token, lưu password_resets (có thời hạn);
  :Gửi email chứa link đặt lại mật khẩu;
  :Người dùng mở link trong email (trước khi hết hạn);
  :Hiển thị form nhập mật khẩu mới và xác nhận;
  :Người dùng nhập mật khẩu mới, xác nhận và gửi;
  :Kiểm tra token còn hợp lệ;
  if (Token còn hợp lệ?) then (Đúng)
    :Cập nhật mật khẩu, xóa token;
    :Thông báo thành công, chuyển trang đăng nhập;
    stop
  else (Hết hạn / sai)
    #FFCDD2:Thông báo link hết hạn hoặc không hợp lệ;
    note right
      Quay lại bước nhập email
    end note
    goto nhap_email
  endif
else (Không)
  #FFCDD2:Thông báo email chưa đăng ký;
  note right
    Quay lại bước nhập email
  end note
  goto nhap_email
endif

@enduml
