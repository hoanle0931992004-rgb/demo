' Sơ đồ hoạt động theo docs/luonghd.md — Nhóm xác thực (UC01–UC03)
' Kiểm tra logic: UC01 (3a/3b), UC02 (3→4), UC03 (3a + 9a gửi lại)

@startuml luonghd-uc01-dang-ky
title UC01: Đăng ký

!theme plain
skinparam backgroundColor #FEFEFE
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #4169E1
skinparam ArrowColor #4169E1
skinparam swimlaneTitleBackgroundColor #B3E5FC
skinparam swimlaneBorderColor #0288D1

|Người dùng|
start
:Truy cập trang đăng ký;

repeat
  |Hệ thống|
  :Yêu cầu nhập thông tin đăng ký;
  |Người dùng|
  :Nhập thông tin\n(email, mật khẩu, xác nhận, họ tên, SĐT);
  |Hệ thống|
  :Kiểm tra tính hợp lệ và email chưa tồn tại;
  if (Hợp lệ?) then (Đúng)
    break
  else (Sai)
    if (Email đã tồn tại?) then (Có)
      #FFCDD2:Hiển thị "Email đã được sử dụng",\nyêu cầu email khác;
    else (Không)
      #FFCDD2:Hiển thị "Xác nhận mật khẩu không đúng",\nyêu cầu nhập lại;
    endif
  endif
repeat while (Nhập lại?) is (có)
->Không;

|Hệ thống|
:Lưu tài khoản mới vào CSDL;
:Thông báo đăng ký thành công,\nchuyển hướng trang đăng nhập;
stop

@enduml

@startuml luonghd-uc02-dang-nhap
title UC02: Đăng nhập

!theme plain
skinparam backgroundColor #FEFEFE
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #4169E1
skinparam ArrowColor #4169E1
skinparam swimlaneTitleBackgroundColor #B3E5FC
skinparam swimlaneBorderColor #0288D1

|Người dùng|
start
:Truy cập trang đăng nhập;

repeat
  |Hệ thống|
  :Yêu cầu nhập thông tin đăng nhập;
  |Người dùng|
  :Nhập email, mật khẩu;
  |Hệ thống|
  :Kiểm tra thông tin đăng nhập tồn tại và chính xác;
  if (Đúng?) then (Đúng)
    break
  else (Sai)
    #FFCDD2:Hiển thị "Email hoặc mật khẩu không đúng",\nyêu cầu nhập lại;
  endif
repeat while (Nhập lại?) is (có)
->Không;

|Hệ thống|
:Kiểm tra tài khoản chưa bị khóa;
if (Bị khóa?) then (Có)
  #FFCDD2:Hiển thị "Tài khoản đã bị khóa",\nliên hệ Admin;
  stop
else (Không)
  :Tạo phiên đăng nhập;
  :Chuyển đến trang chủ theo vai trò;
  stop
endif

@enduml

@startuml luonghd-uc03-quen-mat-khau
title UC03: Quên mật khẩu

!theme plain
skinparam backgroundColor #FEFEFE
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #4169E1
skinparam ArrowColor #4169E1
skinparam swimlaneTitleBackgroundColor #B3E5FC
skinparam swimlaneBorderColor #0288D1

|Người dùng|
start
:Truy cập trang quên mật khẩu;

label gui_lai_yeu_cau_email
repeat
  |Hệ thống|
  :Yêu cầu nhập email đăng ký;
  |Người dùng|
  :Nhập email, gửi yêu cầu khôi phục;
  |Hệ thống|
  :Kiểm tra email tồn tại trong hệ thống;
  if (Tồn tại?) then (Có)
    break
  else (Không)
    #FFCDD2:Hiển thị "Email chưa được đăng ký";
  endif
repeat while (Thử lại?) is (có)
->Không;

|Hệ thống|
:Tạo token, lưu password_resets (thời hạn);
:Gửi email chứa link đặt lại mật khẩu;

|Người dùng|
:Mở link trong email;

|Hệ thống|
:Hiển thị form mật khẩu mới và xác nhận;

|Người dùng|
:Nhập mật khẩu mới, xác nhận;

|Hệ thống|
:Kiểm tra token còn hợp lệ;
if (Token hợp lệ?) then (Có)
  :Cập nhật mật khẩu mới, xóa token;
  :Thông báo thành công, chuyển đăng nhập;
  stop
else (Hết hạn / không hợp lệ)
  #FFCDD2:Hiển thị "Link đã hết hạn",\nyêu cầu gửi lại yêu cầu quên mật khẩu;
  goto gui_lai_yeu_cau_email
endif

@enduml
