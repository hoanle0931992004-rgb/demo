@startuml luonghd-uc04-quan-ly-tai-khoan
title UC04: Quản lý tài khoản cá nhân

!theme plain
skinparam backgroundColor #FEFEFE
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #4169E1
skinparam ArrowColor #4169E1
skinparam swimlaneTitleBackgroundColor #B3E5FC
skinparam swimlaneBorderColor #0288D1

|Người dùng|
start
:Đăng nhập, truy cập trang quản lý tài khoản;

|Hệ thống|
:Hiển thị thông tin cá nhân hiện tại\n(họ tên, email, SĐT, địa chỉ, avatar);

|Người dùng|
if (Thao tác?) then (Cập nhật thông tin)
  :Chỉnh sửa và gửi lên hệ thống;
  |Hệ thống|
  :Lưu thông tin mới, thông báo thành công;
else (Đổi mật khẩu)
  repeat
    |Người dùng|
    :Nhập mật khẩu cũ, mật khẩu mới, xác nhận;
    |Hệ thống|
    :Kiểm tra mật khẩu cũ đúng;
    if (Đúng?) then (Đúng)
      :Cập nhật mật khẩu mới;
      break
    else (Sai)
      #FFCDD2:Hiển thị lỗi, yêu cầu nhập lại;
    endif
  repeat while (Nhập lại?) is (có)
  ->Không;
endif

stop

@enduml

@startuml luonghd-uc05-tao-yeu-cau-thu-gom
title UC05: Tạo yêu cầu thu gom

!theme plain
skinparam backgroundColor #FEFEFE
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #4169E1
skinparam ArrowColor #4169E1
skinparam swimlaneTitleBackgroundColor #B3E5FC
skinparam swimlaneBorderColor #0288D1

|Người dùng|
start
:Truy cập chức năng tạo yêu cầu thu gom;

|Hệ thống|
:Hiển thị form (loại rác, số lượng, địa chỉ, ngày hẹn, ghi chú);

repeat
  |Người dùng|
  :Chọn loại rác, nhập số lượng ước tính;
  if (Tải ảnh rác?) then (Có)
    :Tải ảnh lên;
    |Hệ thống|
    :AI phân tích ảnh, gợi ý loại rác, tự điền;
  else (Không)
    |Người dùng|
    :Nhập thủ công loại rác;
  endif
  |Người dùng|
  :Nhập địa chỉ và các thông tin còn lại;
  :Xác nhận và gửi yêu cầu;
  |Hệ thống|
  :Kiểm tra đủ thông tin bắt buộc;
  if (Đủ?) then (Đủ)
    break
  else (Thiếu)
    #FFCDD2:Hiển thị lỗi, yêu cầu bổ sung;
  endif
repeat while (Sửa và gửi lại?) is (có)
->Không;

|Hệ thống|
:Lưu yêu cầu (trạng thái PENDING);
:Thông báo thành công và thông tin yêu cầu;
stop

@enduml

@startuml luonghd-uc06-theo-doi-trang-thai
title UC06: Theo dõi trạng thái yêu cầu

!theme plain
skinparam backgroundColor #FEFEFE
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #4169E1
skinparam ArrowColor #4169E1
skinparam swimlaneTitleBackgroundColor #B3E5FC
skinparam swimlaneBorderColor #0288D1

|Người dùng|
start
:Truy cập trang theo dõi yêu cầu;

|Hệ thống|
:Hiển thị danh sách yêu cầu\n(PENDING, COLLECTING, COMPLETED, CANCELLED);

|Người dùng|
:Chọn xem chi tiết một yêu cầu;

|Hệ thống|
:Hiển thị chi tiết và lịch sử cập nhật trạng thái;

|Người dùng|
if (Chọn hủy yêu cầu?) then (Có)
  |Hệ thống|
  if (Trạng thái là PENDING?) then (Có)
    :Cập nhật trạng thái CANCELLED;
  else (Không)
    #FFCDD2:Thông báo không thể hủy;
  endif
else (Không)
endif

stop

@enduml

