@startuml luonghd-uc08-doi-thuong
title UC08: Đổi thưởng

!theme plain
skinparam backgroundColor #FEFEFE
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #4169E1
skinparam ArrowColor #4169E1
skinparam swimlaneTitleBackgroundColor #B3E5FC
skinparam swimlaneBorderColor #0288D1

|Người dùng|
start
:Truy cập trang đổi thưởng;

|Hệ thống|
:Hiển thị danh sách phần thưởng (điểm đổi, số lượng còn);

|Người dùng|
:Chọn phần thưởng;

|Hệ thống|
:Kiểm tra điểm đủ và phần thưởng còn hàng;
if (Đủ điểm?) then (Đủ)
  if (Còn hàng?) then (Có)
    |Người dùng|
    :Xác nhận đổi thưởng;
    |Hệ thống|
    :Trừ điểm, cập nhật số lượng, ghi lịch sử đổi thưởng;
    :Thông báo đổi thưởng thành công;
    stop
  else (Hết hàng)
    #FFCDD2:Hiển thị "Phần thưởng đã hết",\nyêu cầu chọn phần thưởng khác;
    stop
  endif
else (Không đủ)
  #FFCDD2:Hiển thị "Điểm không đủ",\nyêu cầu tích thêm điểm;
  stop
endif

@enduml

