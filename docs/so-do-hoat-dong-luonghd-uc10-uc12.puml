' docs/luonghd.md — Nhân viên (UC10–UC12)

@startuml luonghd-uc10-xem-nhan-yeu-cau
title UC10: Xem và nhận yêu cầu

!theme plain
skinparam backgroundColor #FEFEFE
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #4169E1
skinparam ArrowColor #4169E1
skinparam swimlaneTitleBackgroundColor #B3E5FC
skinparam swimlaneBorderColor #0288D1

|Người dùng|
start
:Đăng nhập, truy cập trang yêu cầu thu gom;

|Hệ thống|
:Hiển thị danh sách yêu cầu\n(PENDING, COLLECTING, COMPLETED);

|Người dùng|
:Chọn xem chi tiết yêu cầu;

|Hệ thống|
:Hiển thị chi tiết (loại rác, số lượng, địa chỉ, SĐT, ngày hẹn);

|Người dùng|
:Chọn nhận yêu cầu;

|Hệ thống|
if (Yêu cầu còn trạng thái PENDING?) then (Có)
  :Gán nhân viên, cập nhật COLLECTING, lưu lịch sử;
  :Thông báo nhận yêu cầu thành công;
  stop
else (Không)
  #FFCDD2:Thông báo yêu cầu đã được\nnhân viên khác nhận, cập nhật danh sách;
  stop
endif

@enduml

@startuml luonghd-uc11-thu-gom-xac-minh
title UC11: Thu gom và xác minh

!theme plain
skinparam backgroundColor #FEFEFE
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #4169E1
skinparam ArrowColor #4169E1
skinparam swimlaneTitleBackgroundColor #B3E5FC
skinparam swimlaneBorderColor #0288D1

|Người dùng|
start
:Truy cập chi tiết yêu cầu đang xử lý (COLLECTING);

|Hệ thống|
:Hiển thị địa chỉ, liên hệ, loại rác ước tính;

|Người dùng|
:Thực hiện thu gom tại địa chỉ;
:Cân và xác minh loại rác, nhập khối lượng thực tế;
:Cập nhật thông tin xác minh lên hệ thống;

|Hệ thống|
:Lưu loại rác và khối lượng xác minh;
:Cập nhật trạng thái COMPLETED, lưu lịch sử trạng thái;
:Tính điểm tích lũy, cộng điểm khách hàng, gửi thông báo;
stop

@enduml

@startuml luonghd-uc12-thong-ke-bao-cao-nv
title UC12: Thống kê và báo cáo (Nhân viên)

!theme plain
skinparam backgroundColor #FEFEFE
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #4169E1
skinparam ArrowColor #4169E1
skinparam swimlaneTitleBackgroundColor #B3E5FC
skinparam swimlaneBorderColor #0288D1

|Người dùng|
start
:Truy cập trang thống kê và báo cáo;

|Hệ thống|
:Thống kê số lượng yêu cầu đã xử lý;
:Thống kê khối lượng rác đã thu gom;
:Thống kê theo loại rác;
:Hiển thị hiệu suất thu gom;

|Người dùng|
if (Chọn khoảng thời gian?) then (Có)
  |Hệ thống|
  :Cập nhật báo cáo theo ngày/tuần/tháng;
else (Không)
endif

stop

@enduml
