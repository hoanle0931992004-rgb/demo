@startuml so-do-hoat-dong-dang-nhap
title Đăng nhập

!theme plain
skinparam backgroundColor #FEFEFE
skinparam ActivityFontSize 13
skinparam ActivityBorderColor #4169E1
skinparam ArrowColor #4169E1
skinparam swimlaneTitleBackgroundColor #B3E5FC
skinparam swimlaneBorderColor #0288D1

|Người dùng|
start
:Yêu cầu đăng nhập;

repeat
  |Hệ thống|
  :Yêu cầu nhập thông tin đăng nhập;
  |Người dùng|
  :Nhập email, mật khẩu;
  |Hệ thống|
  :Kiểm tra thông tin;
  if (Thông tin đúng?) then (Đúng)
    break
  else (Sai)
    #FFCDD2:Hiển thị "Email hoặc mật khẩu không đúng";
  endif
repeat while (Nhập lại?) is (có)
->Không;

|Hệ thống|
:Kiểm tra tài khoản bị khóa;
if (Bị khóa?) then (Có)
  #FFCDD2:Hiển thị "Tài khoản đã bị khóa";
  stop
else (Không)
  :Tạo phiên đăng nhập;
  :Chuyển đến trang chủ;
  stop
endif

@enduml
